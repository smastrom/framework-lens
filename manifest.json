{
  "manifest_version": 3,
  "name": "Framework Lens",
  "version": "1.1.0",
  "description": "Detect frontend frameworks and show their icons in the Firefox toolbar.",
  "browser_specific_settings": {
    "gecko": {
      "id": "framework-lens@smastrom.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage", "scripting", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["src/catalog.js", "src/background.js"] },
  "action": {
    "default_title": "Framework Lens",
    "default_icon": "icons/lens.svg",
    "default_popup": "popup/index.html"
  },
  "icons": { "48": "icons/lens.svg", "96": "icons/lens.svg" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/probe.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
